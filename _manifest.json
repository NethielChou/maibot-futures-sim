{
  "manifest_version": 2,
  "id": "github.nethielchou.mai-futures-sim",
  "version": "0.8.6",
  "plugin_type": "automation",
  "name": "麦麦期货模拟盘",
  "description": "让麦麦用自己的判断交易一个本地虚拟期货账户：真实合约行情、模拟成交与结算、程序风控、群内汇报；纯娱乐模拟盘，不接真实交易通道。",
  "display": {
    "icon": {
      "type": "local",
      "value": "icon.png",
      "fallback": "line-chart",
      "background": "#12324A"
    }
  },
  "author": {
    "name": "NethielChou",
    "url": "https://github.com/NethielChou"
  },
  "license": "AGPL-3.0",
  "urls": {
    "repository": "https://github.com/NethielChou/maibot-futures-sim",
    "homepage": "https://github.com/NethielChou/maibot-futures-sim",
    "documentation": "https://github.com/NethielChou/maibot-futures-sim/blob/main/README.md",
    "issues": "https://github.com/NethielChou/maibot-futures-sim/issues"
  },
  "changelog": "CHANGELOG.md",
  "host_application": {
    "min_version": "1.3.13",
    "max_version": "1.3.99"
  },
  "sdk": {
    "min_version": "2.21.0",
    "max_version": "2.21.99"
  },
  "dependencies": [],
  "capabilities": [
    "send.text",
    "send.forward",
    "llm.generate",
    "chat.get_stream_by_group_id",
    "chat.get_stream_by_user_id",
    "message.get_recent",
    "config.get"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  }
}
